 <button class="btn" onclick="startDaily()">🎯 Start Today's Study</button>
</div>

<div class="grid" style="margin-top:14px">
 <div class="stat"><b id="testsStat">0</b><span>Tests</span></div>
 <div class="stat"><b id="questionsStat">0</b><span>Questions</span></div>
 <div class="stat"><b id="accuracyStat">0%</b><span>Accuracy</span></div>
 <div class="stat"><b id="bestStat">0%</b><span>Best Score</span></div>
</div>

<div class="section-title">🚀 Quick Start</div>

<div class="grid">
 <button class="card" onclick="show('subjects')">📚<br><b>Subjects</b></button>
 <button class="card" onclick="show('tests')">🧪<br><b>Test Series</b></button>
 <button class="card" onclick="show('notes')">📖<br><b>Notes</b></button>
 <button class="card" onclick="show('custom')">🎯<br><b>Custom Exam</b></button>
</div>

<div class="section-title">🏆 Your Progress</div>
<div class="card">
 <div id="levelText"><b>Level 1 • Beginner</b></div>
 <div class="progress"><i id="xpBar"></i></div>
 <div class="small" id="xpText">0 XP</div>
</div>

<div class="section-title">🔥 Achievements</div>
<div class="card" id="badges"></div>

</section>


<!-- SUBJECTS -->
<section id="subjects" class="hide">
<div class="section-title">📚 Subjects</div>

<div id="subjectList"></div>
</section>


<!-- CHAPTERS -->
<section id="chapters" class="hide">
<button class="btn secondary" onclick="show('subjects')">← Subjects</button>
<div class="section-title" id="chapterTitle"></div>
<div id="chapterList"></div>
</section>


<!-- NOTES -->
<section id="notes" class="hide">
<div class="section-title">📖 Chapter Notes</div>

<select id="noteSubject" onchange="loadNotes()"></select>
<select id="noteChapter" onchange="renderNote()"></select>

<div id="noteContent"></div>
</section>


<!-- TESTS -->
<section id="tests" class="hide">
<div class="section-title">🧪 Test Series</div>

<div class="card">
