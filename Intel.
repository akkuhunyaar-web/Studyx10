 <p class="small">Basic concepts • 20 questions</p>
 <button class="btn green" onclick="startDifficulty('Easy')">Start Easy</button>
</div>

<div class="card">
 <h3>🟡 Medium Test</h3>
 <p class="small">Board-level practice • 20 questions</p>
 <button class="btn" onclick="startDifficulty('Medium')">Start Medium</button>
</div>

<div class="card">
 <h3>🔴 Hard Test</h3>
 <p class="small">Challenge yourself • 20 questions</p>
 <button class="btn red" onclick="startDifficulty('Hard')">Start Hard</button>
</div>
</section>


<!-- CUSTOM -->
<section id="custom" class="hide">
<div class="section-title">🎯 Custom Exam</div>

<div class="card">
 <b>Select Subjects & Chapters</b>
 <div id="customChapters"></div>

 <label class="small">Difficulty</label>
 <select id="customDifficulty">
  <option value="Any">Any Difficulty</option>
  <option value="Easy">Easy</option>
  <option value="Medium">Medium</option>
  <option value="Hard">Hard</option>
 </select>

 <label class="small">Questions</label>
 <select id="customCount">
  <option>10</option>
  <option selected>20</option>
  <option>30</option>
  <option>40</option>
 </select>

 <button class="btn" onclick="startCustom()">🚀 Start Custom Exam</button>
</div>
</section>


<!-- QUIZ -->
<section id="quiz" class="hide">

<div class="top">
 <b id="quizTitle">Test</b>
 <span class="timer" id="timer">20:00</span>
</div>

<div class="progress"><i id="quizProgress"></i></div>

<div class="small" id="quizNumber"></div>

<div class="card">
 <div class="question" id="questionText"></div>
 <div id="options"></div>
</div>

<button class="btn secondary" id="nextBtn" onclick="nextQuestion()">Next →</button>

</section>


<!-- RESULT -->
<section id="result" class="hide">
<div class="card center">
 <div style="font-size:55px">🏆</div>
 <h2>Test Complete!</h2>
 <p id="resultScore"></p>
 <div class="section-title">Performance</div>
 <div class="grid">
  <div class="stat"><b id="rCorrect">0</b><span>Correct</span></div>
  <div class="stat"><b id="rWrong">0</b><span>Wrong</span></div>
  <div class="stat"><b id="rPercent">0%</b><span>Score</span></div>
  <div class="stat"><b id="rXP">0</b><span>XP</span></div>
 </div>

 <button class="btn" onclick="show('home')">🏠 Home</button>
 <button class="btn secondary" onclick="show('tests')">🧪 More Tests</button>
</div>
</section>


<!-- PAPERS -->
<section id="papers" class="hide">
<div class="section-title">📄 PYQ & Sample Papers</div>

<div class="card">
 <h3>📝 Previous Year Questions</h3>
 <p class="small">Official CBSE question-paper portal</p>

 <button class="btn" onclick="openLink('https://www.cbse.gov.in/cbsenew/question-paper.html')">
  2020–2026 PYQ Portal
 </button>
</div>

<div class="card">
 <h3>📑 Sample Question Papers</h3>

 <button class="btn" onclick="openLink('https://cbseacademic.nic.in/SQP_CLASSX_2026-27.html')">
  2026–27 Official SQP
 </button>

 <button class="btn secondary" onclick="openLink('https://cbseacademic.nic.in/SQP_CLASSX_2025-26.html')">
  2025–26 Official SQP
 </button>

 <button class="btn secondary" onclick="openLink('https://cbseacademic.nic.in/sqp_archive.html')">
  SQP Archive
 </button>
</div>

<div class="card">
 <b>⚠️ Important</b>
 <p class="small" style="margin-top:7px">
  Official CBSE pages open honge. App fake/unofficial PDF links use nahi karta.
 </p>
</div>
</section>


<!-- PROFILE -->
<section id="profile" class="hide">

<div class="section-title">👤 My Profile</div>

<div class="card">
 <h3>Student Information</h3>

 <label class="small">Student Name</label>
 <input id="studentName" type="text" placeholder="Enter your name">

 <button class="btn" onclick="saveProfile()">Save Profile</button>
</div>

<div class="card">
 <h3>📊 Performance</h3>
 <p>Tests Attempted: <b id="pTests">0</b></p>
 <p>Questions Solved: <b id="pQuestions">0</b></p>
 <p>Correct Answers: <b id="pCorrect">0</b></p>
 <p>Accuracy: <b id="pAccuracy">0%</b></p>
 <p>Best Score: <b id="pBest">0%</b></p>
 <p>XP: <b id="pXP">0</b></p>
 <p>🔥 Streak: <b id="pStreak">0 days</b></p>
</div>

<div class="card">
 <h3>📸 Follow StudyX</h3>
 <p class="small">@akkuhunyarrr</p>
 <button class="btn" onclick="openLink('https://www.instagram.com/akkuhunyarrr/')">
  Instagram खोलें
 </button>
</div>

</section>

</main>


<!-- NAV -->
<div class="nav">
<div class="nav-inner">

<button onclick="show('home')" id="navhome" class="active">
<span>🏠</span>Home
</button>

<button onclick="show('subjects')" id="navsubjects">
<span>📚</span>Subjects
</button>

<button onclick="show('tests')" id="navtests">
<span>🧪</span>Tests
</button>

<button onclick="show('papers')" id="navpapers">
<span>📄</span>Papers
</button>

<button onclick="show('profile')" id="navprofile">
<span>👤</span>Profile
</button>

</div>
</div>

</div>


