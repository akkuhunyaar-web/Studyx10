<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>StudyX 10</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
  padding-bottom:75px;
}
body.dark{background:#10131a;color:#f2f4f8}
button,input,select{font:inherit}
button{cursor:pointer;border:0}
.app{max-width:650px;margin:auto;min-height:100vh}

header{
  background:linear-gradient(135deg,#4f46e5,#7c3aed);
  color:white;padding:20px 18px;
  border-radius:0 0 25px 25px;
}
.top{
 display:flex;justify-content:space-between;align-items:center;
}
.logo{font-size:25px;font-weight:800}
.sub{opacity:.85;font-size:12px;margin-top:4px}
.iconbtn{
 background:rgba(255,255,255,.18);color:white;
 width:40px;height:40px;border-radius:50%;
}

.page{padding:18px}
.section-title{
 font-size:19px;font-weight:800;margin:20px 0 12px
}

.card{
 background:white;border-radius:18px;padding:16px;
 margin-bottom:12px;
 box-shadow:0 5px 18px rgba(20,30,60,.07)
}
.dark .card{background:#191d27;box-shadow:none}

.hero{
 background:linear-gradient(135deg,#eef2ff,#faf5ff);
 border-radius:20px;padding:18px;margin-top:16px;
}
.dark .hero{background:#191d2b}

.hero h2{font-size:23px;margin-bottom:7px}
.hero p{color:#667085;font-size:13px}
.dark .hero p{color:#aeb5c3}

.progress{
 height:9px;background:#e5e7eb;border-radius:10px;
 overflow:hidden;margin:12px 0
}
.progress i{
 display:block;height:100%;
 background:linear-gradient(90deg,#4f46e5,#8b5cf6);
 width:0%
}

.grid{
 display:grid;grid-template-columns:repeat(2,1fr);gap:12px
}
.stat{
 background:white;padding:15px;border-radius:17px
}
.dark .stat{background:#191d27}
.stat b{font-size:22px;display:block}
.stat span{font-size:12px;color:#667085}

.btn{
 width:100%;padding:13px;border-radius:13px;
 background:#4f46e5;color:white;font-weight:700;
 margin-top:9px
}
.btn.secondary{background:#eef2ff;color:#4338ca}
.dark .btn.secondary{background:#292d3b;color:#c7c9ff}
.btn.green{background:#16a34a}
.btn.red{background:#dc2626}
.btn.gray{background:#667085}

.nav{
 position:fixed;bottom:0;left:0;right:0;
 background:white;border-top:1px solid #ddd;
 height:68px;display:flex;justify-content:center;
 z-index:99
}
.dark .nav{background:#171a22;border-color:#292d38}
.nav-inner{
 max-width:650px;width:100%;
 display:flex;justify-content:space-around
}
.nav button{
 background:none;color:#667085;font-size:11px;
 width:20%;padding-top:10px
}
.nav button.active{color:#4f46e5;font-weight:bold}
.nav span{display:block;font-size:21px;margin-bottom:3px}

.subject{
 display:flex;align-items:center;gap:12px
}
.subject-icon{
 width:48px;height:48px;border-radius:15px;
 display:grid;place-items:center;
 background:#eef2ff;font-size:24px
}
.dark .subject-icon{background:#292d3b}

.list-btn{
 display:flex;align-items:center;justify-content:space-between;
 width:100%;background:none;color:inherit;
 padding:14px 0;border-bottom:1px solid #eee;text-align:left
}
.dark .list-btn{border-color:#292d38}

.tag{
 display:inline-block;padding:5px 8px;border-radius:8px;
 background:#eef2ff;color:#4338ca;font-size:11px;font-weight:bold
}
.dark .tag{background:#292d3b;color:#c7c9ff}

input[type=text],input[type=number],select{
 width:100%;padding:13px;border:1px solid #ddd;
 border-radius:12px;background:white;color:#222;
 margin:6px 0 12px
}
.dark input,.dark select{
 background:#191d27;color:white;border-color:#363b48
}

.check{
 display:flex;gap:9px;align-items:center;
 padding:9px 0;font-size:14px
}

.question{
 font-size:18px;font-weight:700;line-height:1.45;
 margin:15px 0
}
.option{
 width:100%;text-align:left;padding:13px;
 background:#f3f4f6;color:#222;
 border-radius:12px;margin:7px 0
}
.dark .option{background:#292d38;color:white}
.option.correct{background:#bbf7d0!important;color:#166534!important}
.option.wrong{background:#fecaca!important;color:#991b1b!important}

.timer{
 background:#111827;color:white;padding:8px 12px;
 border-radius:10px;font-weight:bold;display:inline-block
}

.note h3{margin-bottom:8px}
.note p,.note li{
 font-size:14px;line-height:1.65;color:#555
}
.dark .note p,.dark .note li{color:#c1c6d0}
.note ul{padding-left:20px}

.hide{display:none!important}
.small{font-size:12px;color:#667085}
.dark .small{color:#aeb5c3}
.center{text-align:center}
.badge{
 padding:8px 12px;border-radius:20px;
 background:#fef3c7;color:#92400e;font-size:12px;
 display:inline-block;margin:4px
}
</style>
</head>

<body>
<div class="app">

<header>
 <div class="top">
  <div>
   <div class="logo">📚 StudyX 10</div>
   <div class="sub">CBSE Class 10 • Study Smart</div>
  </div>
  <button class="iconbtn" onclick="toggleDark()">🌙</button>
 </div>
</header>

<main class="page">

<!-- HOME -->
<section id="home">

<div class="hero">
 <h2 id="hello">Welcome, Student 👋</h2>
 <p>Today's target complete karo aur apni preparation strong banao.</p>

 <div class="progress"><i id="dailyBar"></i></div>
